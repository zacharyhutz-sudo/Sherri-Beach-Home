---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You - There’s Always Time for the Sea">
	<main class="max-w-4xl mx-auto px-6 py-24 text-center">
		<div class="mb-8 flex justify-center">
			<div class="bg-[#b6b791]/20 p-6 rounded-full">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-[#b6b791]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
				</svg>
			</div>
		</div>
		
		<h1 class="text-4xl md:text-5xl font-header text-[#92ABBB] mb-6">Booking Request Sent</h1>
		<p class="text-xl opacity-80 mb-12 max-w-2xl mx-auto">
			Thank you for your interest in our beach home! We have received your request and will get back to you shortly to confirm your dates.
		</p>

		<div class="space-y-6">
			<a href="/Sherri-Beach-Home/" class="inline-block bg-[#92ABBB] text-white px-12 py-4 font-subheader text-lg tracking-widest hover:bg-[#9F6C52] transition-all uppercase">
				Back to Home
			</a>
		</div>

		<footer class="mt-24 pt-8 border-t border-[#9F6C52]/10">
			<p class="text-sm opacity-60 italic">"There's Always Time for the Sea"</p>
		</footer>
	</main>
</Layout>
